# Installed, not written here.
node_modules/

# Built by `npm run build`, from web/. Nothing in it is a source file.
dist/

# A self-signed certificate and its private key, made on this machine for testing on a phone.
# `npm run dev:lan` generates a fresh pair; they are never the same twice and never shared.
dev-certs/

# PairDrop's source, kept locally to read while writing docs/01-03. It is somebody else's
# project under its own licence and has no business in this repository: the notes taken from
# it are in docs/, and nothing here is derived from the code itself.
reference/

# Editor and tooling state that belongs to one machine.
.claude/
.vscode/
.idea/
*.swp

# What operating systems leave behind.
.DS_Store
Thumbs.db
desktop.ini

# Local overrides. There are no secrets in this project, and this is how it stays that way.
.env
.env.*
!.env.example

# Scratch output.
*.log
npm-debug.log*
coverage/
.vercel

# A throwaway CDP probe used to drive Chrome on a device over adb. Not part of the app.
cdp-probe.mjs
